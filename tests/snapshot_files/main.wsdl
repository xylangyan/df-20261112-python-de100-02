<?xml version="1.0"?>
<definitions
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://example.com/snapshot/service"
    xmlns:types="http://example.com/snapshot/types"
    targetNamespace="http://example.com/snapshot/service"
    name="SnapshotService">
  <wsdl:import namespace="http://example.com/snapshot/binding" location="binding.wsdl"
      xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"/>
  <types>
    <schema xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:types="http://example.com/snapshot/types"
            xmlns:common="http://example.com/snapshot/common"
            targetNamespace="http://example.com/snapshot/types"
            elementFormDefault="qualified">
      <import namespace="http://example.com/snapshot/common" schemaLocation="types/common.xsd"/>
      <include schemaLocation="types/address-inc.xsd"/>
      <element name="EchoRequest">
        <complexType>
          <sequence>
            <element name="message" type="string"/>
            <element name="address" type="types:Address" minOccurs="0"/>
          </sequence>
        </complexType>
      </element>
      <element name="EchoResponse">
        <complexType>
          <sequence>
            <element name="result" type="string"/>
            <element name="common" type="common:CommonType" minOccurs="0"/>
          </sequence>
        </complexType>
      </element>
    </schema>
  </types>
  <message name="EchoRequestMessage">
    <part name="body" element="types:EchoRequest"/>
  </message>
  <message name="EchoResponseMessage">
    <part name="body" element="types:EchoResponse"/>
  </message>
  <portType name="SnapshotPortType">
    <operation name="Echo">
      <input message="tns:EchoRequestMessage"/>
      <output message="tns:EchoResponseMessage"/>
    </operation>
  </portType>
  <binding name="SnapshotBinding" type="tns:SnapshotPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="Echo">
      <soap:operation soapAction="http://example.com/snapshot/Echo"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="SnapshotService">
    <port name="SnapshotPort" binding="tns:SnapshotBinding">
      <soap:address location="http://example.com/snapshot/endpoint"/>
    </port>
  </service>
</definitions>
